# Local development settings. This file is a template; backend/.env is ignored.
# Environment variables override backend/.env values.
AURA_ENV=development
AURA_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
AURA_SESSION_TTL_SECONDS=28800
AURA_SESSION_IDLE_SECONDS=1800
AURA_COOKIE_SECURE=false
AURA_AUTH_RATE_LIMIT=10
AURA_AUTH_RATE_WINDOW_SECONDS=60
AURA_OLLAMA_BASE_URL=http://127.0.0.1:11434
AURA_CONSISTENCY_MODEL=llama3.2:3b
AURA_CONSISTENCY_TIMEOUT_SECONDS=90

AURA_DB_HOST=localhost
AURA_DB_PORT=5432
AURA_DB_NAME=aura_db
AURA_DB_USER=postgres
AURA_DB_PASSWORD=replace_with_your_local_password
